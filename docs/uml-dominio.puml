@startuml
title SkillSwap — Modelo de dominio
skinparam packageStyle rectangle
hide empty members

package "domain.model" {
  class Profile {
    - userId: String
    - actorType: ActorType
    - reputation: double
    - ratingCount: int
    - active: boolean
    + updateDetails(actor, ...)
    + updateAvailability(actor, slots)
    + recalculateReputation(ratings)
    + activate(actor)
    + deactivate(actor)
  }

  class AvailabilitySlot {
    - startsAt: LocalDateTime
    - endsAt: LocalDateTime
    - capacity: int
    - reserved: int
    + remaining(): int
  }

  class Publication {
    - authorUserId: String
    - type: PublicationType
    - state: PublicationState
    - basePrice: SkillCoins
    + publish(actor)
    + reserve(slotId)
    + recordBookingRequest(requester, slotId)
  }

  class PublicationBuilder <<Builder>> {
    - authorUserId: String
    - authorType: ActorType
    - type: PublicationType
    - title: String
    - description: String
    - category: String
    - modality: Modality
    - durationMinutes: Integer
    - capacity: Integer
    - basePrice: SkillCoins
    - tags: Set<String>
    - availability: List<AvailabilitySlot>
    + title(value): PublicationBuilder
    + description(value): PublicationBuilder
    + category(value): PublicationBuilder
    + modality(value): PublicationBuilder
    + durationMinutes(value): PublicationBuilder
    + capacity(value): PublicationBuilder
    + basePrice(value): PublicationBuilder
    + tag(value): PublicationBuilder
    + addAvailability(slot): PublicationBuilder
    + build(): Publication
  }

  enum ActorType {
    PROFESSIONAL
    ORGANIZATION
    + publicationTypes(): Set<PublicationType>
    + canPublish(type): boolean
  }

  enum PublicationType {
    MENTORSHIP
    SERVICE
    CHALLENGE
  }

  enum PublicationStatus {
    DRAFT
    PUBLISHED
    PAUSED
    CLOSED
    CANCELLED
  }

  class Booking {
    - buyerUserId: String
    - providerUserId: String
    - state: BookingState
    - price: SkillCoins
    - refund: SkillCoins
    + accept(actor)
    + confirmPayment(actor)
    + cancel(actor, reason, refund)
    + complete(actor)
  }

  enum BookingStatus {
    PENDING
    ACCEPTED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    REJECTED
    CANCELLED
  }

  class SkillCoins <<Value Object>> {
    + amount: int
    + plus(other): SkillCoins
    + minus(other): SkillCoins
  }

  class Wallet {
    - userId: String
    - balance: SkillCoins
    + credit(amount, concept)
    + debit(amount, concept)
  }

  class LedgerEntry <<Value Object>> {
    + amount: int
    + resultingBalance: int
    + occurredAt: LocalDateTime
  }

  class Rating {
    - bookingId: String
    - authorUserId: String
    - subjectUserId: String
    - score: int
    + forCompletedBooking(booking, author, score, comment): Rating
  }

  class StatusHistoryEntry <<Value Object>> {
    + from: String
    + to: String
    + actorUserId: String
    + reason: String
    + occurredAt: LocalDateTime
  }
}

package "domain.state" {
  interface PublicationState <<State>>
  class PublicationStates.Draft <<Singleton enum>>
  class PublicationStates.Published <<Singleton enum>>
  class PublicationStates.Paused <<Singleton enum>>
  class PublicationStates.Closed <<Singleton enum>>
  class PublicationStates.Cancelled <<Singleton enum>>

  interface BookingState <<State>>
  class BookingStates.Pending <<Singleton enum>>
  class BookingStates.Accepted <<Singleton enum>>
  class BookingStates.Confirmed <<Singleton enum>>
  class BookingStates.InProgress <<Singleton enum>>
  class BookingStates.Completed <<Singleton enum>>
  class BookingStates.Rejected <<Singleton enum>>
  class BookingStates.Cancelled <<Singleton enum>>
}

package "domain.catalog" {
  abstract class CatalogItem <<Composite: componente>> {
    - id: String
    - name: String
    + parent(): Optional<CatalogCategory>
    + depth(): int
    + children(): List<CatalogItem>
    + stream(): Stream<CatalogItem>
    + skillNames(): Set<String>
    + categoryNames(): Set<String>
    + findCategory(name): Optional<CatalogCategory>
  }
  class CatalogCategory <<Composite: compuesto>> {
    + add(item: CatalogItem): CatalogCategory
  }
  class CatalogSkill <<Composite: hoja>>
}

package "domain.policy" {
  interface RefundPolicy <<Strategy>> {
    + refundFor(booking, cancelledAt, sessionStartsAt): SkillCoins
  }
  class StandardRefundPolicy
  class FlexibleRefundPolicy
}

package "domain.model" {
  interface RecommendationStrategy <<Strategy>> {
    + recommend(profile, candidates, limit): List<Publication>
  }
  class SkillAffinityStrategy
  class RecentPopularityStrategy
}

Profile "1" *-- "0..*" AvailabilitySlot : disponibilidad
Publication "1" *-- "0..*" AvailabilitySlot : franjas publicables
PublicationBuilder ..> Publication : construye borrador
PublicationBuilder ..> ActorType : tipo del autor
Profile --> ActorType : tipo de actor
Publication --> PublicationType : tipo
ActorType "1..*" --> "1..*" PublicationType : puede crear
PublicationBuilder ..> AvailabilitySlot : compone disponibilidad
Publication "1" *-- "0..*" StatusHistoryEntry : historial
Booking "1" *-- "0..*" StatusHistoryEntry : historial
Wallet "1" *-- "0..*" LedgerEntry : movimientos
Wallet --> SkillCoins : saldo
Publication --> SkillCoins : precio base
Booking --> SkillCoins : precio / reintegro
Booking "0..*" --> "1" Publication : se origina en
Rating "0..*" --> "1" Booking : califica contratación
Rating "0..*" ..> "1" Profile : subjectUserId / reputación derivada

CatalogCategory --|> CatalogItem
CatalogSkill --|> CatalogItem
CatalogCategory "0..1" o-- "0..*" CatalogItem : contiene
Publication "0..*" ..> "0..1" CatalogCategory : categoría (por nombre)

Publication --> PublicationState : estado actual
Booking --> BookingState : estado actual
PublicationState ..> PublicationStatus : expone
BookingState ..> BookingStatus : expone
PublicationStates.Draft ..|> PublicationState
PublicationStates.Published ..|> PublicationState
PublicationStates.Paused ..|> PublicationState
PublicationStates.Closed ..|> PublicationState
PublicationStates.Cancelled ..|> PublicationState
BookingStates.Pending ..|> BookingState
BookingStates.Accepted ..|> BookingState
BookingStates.Confirmed ..|> BookingState
BookingStates.InProgress ..|> BookingState
BookingStates.Completed ..|> BookingState
BookingStates.Rejected ..|> BookingState
BookingStates.Cancelled ..|> BookingState

StandardRefundPolicy ..|> RefundPolicy
FlexibleRefundPolicy ..|> RefundPolicy
SkillAffinityStrategy ..|> RecommendationStrategy
RecentPopularityStrategy ..|> RecommendationStrategy

package "Application (referencia externa a Domain)" {
  interface ProfileUseCases
  interface PublicProfileUseCases
  interface PublicationCommandUseCases
  interface PublicationQueryUseCases
  interface DiscoveryUseCases
  interface BookingUseCases
  interface WalletUseCases
  interface RatingUseCases
  interface NotificationUseCases
  interface CurrentUserProvider
  interface TransactionManager
  interface ProfileRepository
  interface PublicationRepository
  interface BookingRepository
  interface RatingRepository

  class PublicProfileFacade <<Facade>> {
    + viewPublicProfile(query: PublicProfileData.PublicProfileQuery): PublicProfileData.PublicProfileView
  }
}

PublicProfileFacade ..|> PublicProfileUseCases
PublicProfileFacade --> ProfileRepository
PublicProfileFacade --> PublicationRepository
PublicProfileFacade --> BookingRepository
PublicProfileFacade --> RatingRepository
PublicProfileFacade --> TransactionManager
PublicProfileFacade ..> Profile : perfil activo y datos públicos
PublicProfileFacade ..> Publication : página publicada devuelta por el puerto
PublicProfileFacade ..> Rating : calificaciones recibidas devueltas por el puerto

note right of PublicProfileFacade
  Esta clase pertenece a Application, no al dominio.
  Coordina lecturas mediante ProfileRepository,
  PublicationRepository, BookingRepository y RatingRepository.
  BookingRepository aporta conteos; no se cargan entidades Booking.
  La Facade no cambia invariantes ni expone entidades JPA:
  Presentation recibe PublicProfileData.PublicProfileView.
end note

package "Presentation (referencia externa a Domain; detalle en uml-aplicacion.puml)" {
  class SkillSwapView <<Swing UI>>
  interface "UiControllers" as DomainUiControllers {
    + busqueda(): UiControllers.BusquedaController
    + publicaciones(): UiControllers.PublicacionController
    + contrataciones(): UiControllers.ContratacionController
    + calificaciones(): UiControllers.CalificacionController
    + wallet(): UiControllers.WalletController
    + notificaciones(): UiControllers.NotificacionController
    + perfiles(): UiControllers.PerfilController
  }
  interface "UiControllers.BusquedaController" as DomainUiBusqueda
  interface "UiControllers.PublicacionController" as DomainUiPublicacion
  interface "UiControllers.ContratacionController" as DomainUiContratacion
  interface "UiControllers.CalificacionController" as DomainUiCalificacion
  interface "UiControllers.WalletController" as DomainUiWallet
  interface "UiControllers.NotificacionController" as DomainUiNotificacion
  interface "UiControllers.PerfilController" as DomainUiPerfil

  class BusquedaUiController <<GRASP Controller>> {
    - discovery: DiscoveryUseCases
    - identity: CurrentUserProvider
  }
  class PublicacionUiController <<GRASP Controller>> {
    - commands: PublicationCommandUseCases
    - queries: PublicationQueryUseCases
    - identity: CurrentUserProvider
  }
  class ContratacionUiController <<GRASP Controller>> {
    - bookings: BookingUseCases
    - identity: CurrentUserProvider
  }
  class CalificacionUiController <<GRASP Controller>> {
    - ratings: RatingUseCases
    - identity: CurrentUserProvider
  }
  class WalletUiController <<GRASP Controller>> {
    - wallets: WalletUseCases
    - identity: CurrentUserProvider
  }
  class NotificacionUiController <<GRASP Controller>> {
    - notifications: NotificationUseCases
    - identity: CurrentUserProvider
  }
  class PerfilUiController <<GRASP Controller>> {
    - profiles: ProfileUseCases
    - publicProfiles: PublicProfileUseCases
    - identity: CurrentUserProvider
  }
  class MockSkillSwapControllers <<Mock UI Kit adapter>>
}

SkillSwapView ..> DomainUiControllers
MockSkillSwapControllers ..|> DomainUiControllers
MockSkillSwapControllers ..|> DomainUiBusqueda
MockSkillSwapControllers ..|> DomainUiPublicacion
MockSkillSwapControllers ..|> DomainUiContratacion
MockSkillSwapControllers ..|> DomainUiCalificacion
MockSkillSwapControllers ..|> DomainUiWallet
MockSkillSwapControllers ..|> DomainUiNotificacion
MockSkillSwapControllers ..|> DomainUiPerfil
BusquedaUiController ..|> DomainUiBusqueda
PublicacionUiController ..|> DomainUiPublicacion
ContratacionUiController ..|> DomainUiContratacion
CalificacionUiController ..|> DomainUiCalificacion
WalletUiController ..|> DomainUiWallet
NotificacionUiController ..|> DomainUiNotificacion
PerfilUiController ..|> DomainUiPerfil
BusquedaUiController --> DiscoveryUseCases
PublicacionUiController --> PublicationCommandUseCases
PublicacionUiController --> PublicationQueryUseCases
ContratacionUiController --> BookingUseCases
CalificacionUiController --> RatingUseCases
WalletUiController --> WalletUseCases
NotificacionUiController --> NotificationUseCases
PerfilUiController --> ProfileUseCases
PerfilUiController --> PublicProfileUseCases
BusquedaUiController --> CurrentUserProvider
PublicacionUiController --> CurrentUserProvider
ContratacionUiController --> CurrentUserProvider
CalificacionUiController --> CurrentUserProvider
WalletUiController --> CurrentUserProvider
NotificacionUiController --> CurrentUserProvider
PerfilUiController --> CurrentUserProvider

note bottom of DomainUiControllers
  UiControllers es el contrato consumido por SkillSwapView.
  Las clases de Presentation dependen de puertos de entrada
  de Application; no tienen dependencias directas con agregados
  de Domain ni con adaptadores de persistencia. Los métodos y DTOs
  de cada contrato se detallan en uml-aplicacion.puml.
  recomendar(userId) forma parte de BusquedaController;
  no existe un RecomendacionController separado.
end note

note right of Rating
  La fábrica de dominio exige que la contratación
  esté completada y que quien califica sea participante.
  La unicidad por autor y contratación se garantiza
  en el puerto de persistencia/caso de uso.
end note

note right of ActorType
  Un profesional puede crear mentorías y servicios; una
  organización, desafíos. Es la única diferencia entre tipos:
  datos, estados, permisos del autor y contratación son iguales.
  El autor elige el tipo al crear el borrador y el dominio
  rechaza uno que su actor no puede crear.
end note

note bottom of AvailabilitySlot
  La franja valida el intervalo y la capacidad.
  Publicación controla cuándo se reserva o libera.
end note

note right of Profile
  Activar y dar de baja solo cambia el estado lógico del perfil.
  Las contrataciones mantienen su estado e historial propios.
end note

note bottom of Booking
  BookingStates usa enums sin datos propios: cada estado tiene
  una sola instancia inmutable. Booking conserva el estado actual,
  participantes, pagos e historial propios de cada contratación.
end note

note right of CatalogCategory
  Composite (#37): la categoría protege el árbol al agregar.
  Un elemento tiene un solo padre, no hay ciclos, los hermanos
  no repiten nombre y el nombre de una categoría es único.
  Hojas y ramas se recorren con las mismas operaciones.
end note

@enduml
